# HausTap Production Environment Configuration
# Copy this file to .env.production and update with your production values

# Application
APP_NAME="HausTap"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=haustap_db
DB_USERNAME=haustap_user
DB_PASSWORD=your_secure_password_here

# Redis Cache
REDIS_HOST=redis
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# Firebase Configuration
FIREBASE_PROJECT_ID=haustap-booking-system
FIREBASE_DATABASE_URL=https://haustap-booking-system-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_STORAGE_BUCKET=haustap-booking-system.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_PATH=/var/www/storage/app/firebase/service-account.json

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_TTL=1440
JWT_REFRESH_TTL=20160

# Mail Configuration (Optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@haustap.com
MAIL_FROM_NAME="${APP_NAME}"

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_DEFAULT=default

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=haustap_cache

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# File Storage
FILESYSTEM_DISK=local

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-firebase-hosting-domain.web.app

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Security
SANCTUM_STATEFUL_DOMAINS=your-domain.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true